# Neon PostgreSQL
# Na Vercel: use a URL "pooled" no app. Migrate remove "-pooler" sozinho
# (ou defina DIRECT_URL com a connection string direta do Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Auth.js
AUTH_SECRET="gere-com-openssl-rand-base64-32"
# URL pública da aplicação (local ou produção)
AUTH_URL="http://localhost:3000"

# Stripe (Visitados Prime)
# Use chaves de TESTE (pk_test_ / sk_test_) enquanto desenvolve.
# Aceita NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY ou STRIPE_PUBLISHABLE_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
# Webhook: Developers > Webhooks > endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# Seed em produção (POST /api/seed com header x-seed-secret)
# SEED_SECRET="um-segredo-forte"

# Opcional: login com Google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"
